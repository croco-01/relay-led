    {
        "id": "a87675bc406494ac",
        "type": "function",
        "z": "06047bf462c9e047",
        "name": "Physical Button Handler",
        "func": "let now = Date.now();\nlet last = flow.get('last_button_press') || 0;\n\nif (now - last < 300) {\n    return null;\n}\n\nflow.set('last_button_press', now);\n\nreturn {\n    payload: 'ON',\n    topic: 'physical_button'\n};",
        "outputs": 1,
        "x": 600,
        "y": 180,
        "wires": [
            [
                "65474c54c0f8152e",
                "fb5dd0f1c2b7c0b1"
            ]
        ]
    },
    {
        "id": "fb5dd0f1c2b7c0b1",
        "type": "function",
        "z": "06047bf462c9e047",
        "name": "Track Button Presses",
        "func": "let count = Number(flow.get('total_presses') || 0) + 1;\nflow.set('total_presses', count);\n\nmsg.payload = count;\nmsg.topic = 'Button Presses';\nreturn msg;",
        "outputs": 1,
        "x": 820,
        "y": 300,
        "wires": [
            [
                "d452d33b9facb6da"
            ]
        ]
    },
    {
        "id": "65474c54c0f8152e",
        "type": "function",
        "z": "06047bf462c9e047",
        "name": "Relay Controller + Countdown",
        "func": "const command = String(msg.payload).toUpperCase();\nlet oldTimer = flow.get('relay_timer');\n\nif (command === 'ON') {\n\n    if (oldTimer) {\n        clearInterval(oldTimer);\n    }\n\n    flow.set('relay_state', true);\n\n    node.send([\n        { payload: 'ON' },\n        { payload: true },\n        { payload: 'ON' },\n        { payload: 5 }\n    ]);\n\n    let remaining = 5;\n\n    let timer = setInterval(function() {\n        remaining--;\n\n        if (remaining > 0) {\n            node.send([\n                null,\n                null,\n                { payload: 'ON' },\n                { payload: remaining }\n            ]);\n        } else {\n            clearInterval(timer);\n            flow.set('relay_timer', null);\n            flow.set('relay_state', false);\n\n            node.send([\n                { payload: 'OFF' },\n                { payload: false },\n                { payload: 'OFF' },\n                { payload: 0 }\n            ]);\n        }\n    }, 1000);\n\n    flow.set('relay_timer', timer);\n    return null;\n}\n\nif (command === 'OFF') {\n\n    if (oldTimer) {\n        clearInterval(oldTimer);\n    }\n\n    flow.set('relay_timer', null);\n    flow.set('relay_state', false);\n\n    node.send([\n        { payload: 'OFF' },\n        { payload: false },\n        { payload: 'OFF' },\n        { payload: 0 }\n    ]);\n\n    return null;\n}\n\nreturn null;",
        "outputs": 4,
        "x": 710,
        "y": 80,
        "wires": [
            [
                "990df92c4f40400b"
            ],
            [
                "e87269ce1a06d3b8"
            ],
            [
                "8580dffd3b0e2ca9"
            ],
            [
                "85751a0cbc8d8d87"
            ]
        ]
    },
    {
        "id": "990df92c4f40400b",
        "type": "function",
        "z": "06047bf462c9e047",
        "name": "Build pinctrl Command",
        "func": "const command = String(msg.payload).toUpperCase();\n\nif (command === 'ON') {\n    msg.payload = 'pinctrl set 23 op dl';\n} else {\n    msg.payload = 'pinctrl set 23 ip pu';\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
